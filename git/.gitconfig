[user]
	name = Dylan Goings
	email = dylan@dgoings.com
[mergetool]
	keepBackup = true
[alias]
	a = add
	aa = add .
	st = status
	ci = commit -m
	ca = commit --amend --no-edit
	co = checkout
	tb = git checkout --track
	br = branch
	lg = log --graph --topo-order --pretty='format:%h %ai %s%d (%an)'
	# skip-worktree helpers: stop/resume tracking local edits to a tracked file
	lock = update-index --skip-worktree
	unlock = update-index --no-skip-worktree
	locked = !git ls-files -v | grep ^S | cut -c3-
	pgl = "!source ~/.githelpers && pretty_git_log"
	pbr = "!source ~/.githelpers && pretty_git_branches"
	pu = push
	pl = pull
	irb = !git rebase -i origin/main
	mgff = merge --ff-only
	fe = fetch
	up = !git fetch origin && git rebase origin/master
	cleanup = !git remote prune origin && git gc && git clean -dfx && git stash clear
	df = diff --color
[credential]
	helper = osxkeychain
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
[push]
	default = simple
	autoSetupRemote = true
[pull]
	default = rebase
	rebase = true
[merge]
	conflictstyle = zdiff3
[rebase]
	autoStash = true
	autoSquash = true
[init]
	defaultBranch = main
[core]
	excludesfile = $HOME/.gitignore_global
[credential "https://github.com"]
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://dev.azure.com"]
	useHttpPath = true
# Normalizes ~/.claude/settings.json on the way into git. Claude Code rewrites
# that file live (model, effort, survey timestamps, key order), which made every
# rebase in the dotfiles repo conflict. -S sorts keys to kill reorder churn; the
# deleted keys are per-machine preferences that shouldn't be shared.
# Activated by .gitattributes in the dotfiles repo.
[filter "claude-settings"]
	clean = jq -S 'del(.model, .effortLevel, .feedbackSurveyState)'
	smudge = cat
# Machine-local git config — not tracked in the dotfiles repo.
# Must stay last: settings here override everything above, and an empty
# credential.helper resets the accumulated helper list. Silently ignored
# when the file doesn't exist.
[include]
	path = ~/.gitconfig.local
